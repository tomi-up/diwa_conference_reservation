# Apache .htaccess configuration with dynamic URL & ngrok tunnel support
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not rewrite if file or directory physically exists
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # External 301 Redirect: Convert /page.php -> /page
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ $1 [R=301,L]

    # Internal Rewrite: Route /page -> /page.php
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# Security Protection: Block direct browser access to sensitive files & config directory
<FilesMatch "^\.env|\.git|\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>
